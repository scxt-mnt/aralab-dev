{
  "functions": {
    "api/generate.js": {
      "maxDuration": 300
    },
    "api/fix-reviewer.js": {
      "maxDuration": 300
    },
    "api/update-reviewer.js": {
      "maxDuration": 300
    },
    "api/lesson-titles.js": {
      "maxDuration": 30
    },
    "api/universities.js": {
      "maxDuration": 30
    },
    "api/send-milestones.js": {
      "maxDuration": 30
    },
    "api/fetch-link.js": {
      "maxDuration": 30
    },
    "api/transcribe.js": {
      "maxDuration": 60
    },
    "api/reviewer.js": {
      "maxDuration": 10
    },
    "api/share.js": {
      "maxDuration": 10
    },
    "api/og.js": {
      "maxDuration": 15,
      "includeFiles": "server/fonts/**"
    }
  },
  "crons": [
    {
      "path": "/api/universities",
      "schedule": "0 3 * * 1"
    },
    {
      "path": "/api/send-milestones",
      "schedule": "0 4 * * *"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/privacy",
      "destination": "/index.html"
    },
    {
      "source": "/terms",
      "destination": "/index.html"
    },
    {
      "source": "/delete-account",
      "destination": "/index.html"
    },
    {
      "source": "/r/:id",
      "destination": "/api/share?id=:id"
    }
  ]
}
