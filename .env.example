VITE_SUPABASE_ANON_KEY=sb_publishable_e7vhUvxtgSbUoS6aJzYzZQ_gJdF_-05


# SECRETS: put these in .env.local (local) or Vercel env vars. Never prefix with VITE_.

# Optional backup AI: GROQ_API_KEY=gsk_...    (used only when Gemini fails; put it in .env.local or Vercel, never prefix with VITE_)
# Optional: GROQ_MODEL / GROQ_VISION_MODEL    (a Groq model to try first)
# Optional: GROQ_WHISPER_MODEL=whisper-large-v3-turbo   (v74: Groq speech model for video transcription)
# Optional: GEMINI_MODEL=gemini-3.8-flash     (a preference only; the app auto-detects what is available and falls back)
# Optional: GEMINI_ALLOW_PREMIUM=1            (also consider paid Pro/Argon models)
# Optional: DAILY_USER_LIMIT=3  DAILY_GLOBAL_LIMIT=30
# Optional: GENERATE_BUDGET_MS=280000 (default; keep Vercel maxDuration at 300 for api/generate.js and api/fix-reviewer.js)

# Google Classroom (v56): OAuth "Web application" client ID from Google Cloud Console. Not a secret.
VITE_GOOGLE_CLIENT_ID=
# Google file picker (v56): API key (restricted to Google Picker API + your site) and your Cloud project NUMBER
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_APP_ID=
# Shown on the Privacy / Terms pages (/privacy, /terms) as the contact address
VITE_CONTACT_EMAIL=

# v80 (optional) Redis cache for opening reviewers: a free Upstash Redis database (or Vercel KV). Without these the app reads straight from Supabase.
# UPSTASH_REDIS_REST_URL=https://<name>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=
